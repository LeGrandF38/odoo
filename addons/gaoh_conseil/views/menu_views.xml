<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu Principal -->
    <menuitem id="menu_gaoh_conseil_root"
              name="Gaoh Conseil"
              sequence="10"
              web_icon="gaoh_conseil,static/description/icon.png"/>

    <!-- Menu Investisseurs -->
    <menuitem id="menu_gaoh_investisseurs"
              name="Investisseurs"
              parent="menu_gaoh_conseil_root"
              action="action_investisseur"
              sequence="10"/>

    <!-- Menu Investissements -->
    <menuitem id="menu_gaoh_investissements"
              name="Investissements"
              parent="menu_gaoh_conseil_root"
              sequence="20"/>

    <!-- Sous-menu Investissements Immobiliers -->
