              name="Investissements Immobiliers"
              parent="menu_gaoh_investissements"
              action="action_investissement_immobilier"
              sequence="10"/>

    <!-- Sous-menu Placements -->
    <menuitem id="menu_gaoh_investissement_placement"
              name="Placements Financiers"
              parent="menu_gaoh_investissements"
              action="action_investissement_placement"
              sequence="20"/>

    <!-- Menu Configuration -->
    <menuitem id="menu_gaoh_configuration"
              name="Configuration"
              parent="menu_gaoh_conseil_root"
              sequence="100"/>

    <!-- Sous-menu Import -->
