<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste Investissement Immobilier -->
    <record id="view_investissement_immobilier_tree" model="ir.ui.view">
        <field name="name">gaoh.investissement_immobilier.tree</field>
        <field name="model">gaoh.investissement_immobilier</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Investissements Immobiliers">
                <field name="investisseur_id"/>
                <field name="nom_programme"/>
                <field name="ville_programme"/>
                <field name="dispositif_fiscal"/>
                <field name="promoteur"/>
                <field name="date_reservation"/>
                <field name="date_livraison"/>
                <field name="prix_ttc" widget="monetary"/>
                <field name="etat_commande" decoration-success="etat_commande == 'livree'" decoration-info="etat_commande == 'signee'" decoration-warning="etat_commande == 'en_cours'" decoration-danger="etat_commande == 'annulee'"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire Investissement Immobilier -->
    <record id="view_investissement_immobilier_form" model="ir.ui.view">
        <field name="name">gaoh.investissement_immobilier.form</field>
        <field name="model">gaoh.investissement_immobilier</field>
        <field name="arch" type="xml">
            <form string="Investissement Immobilier">
                <header>
                    <field name="etat_commande" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="nom_programme"/>
                        </h1>
                    </div>
                    <div style="max-width: 1000px; margin: 0 auto; padding: 20px;">
                        <group col="2">
                            <group string="Investisseur" colspan="1">
                                <field name="investisseur_id"/>
                                <field name="email_investisseur"/>
                                <field name="consultant_apporteur"/>
                            </group>
                            <group string="Programme" colspan="1">
                                <field name="code_programme"/>
                                <field name="ville_programme"/>
                                <field name="promoteur"/>
                                <field name="gestionnaire"/>
                                <field name="stellium_sci"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="Lot" colspan="1">
                                <field name="lot"/>
                                <field name="type_lot"/>
                                <field name="dispositif_fiscal"/>
                            </group>
                            <group string="Dates Importantes" colspan="1">
                                <field name="date_option"/>
                                <field name="date_reservation"/>
                                <field name="date_livraison"/>
                                <field name="date_acte"/>
                                <field name="date_vc"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="Commande" colspan="1">
                                <field name="numero_commande"/>
                                <field name="paiement_comptant"/>
                                <field name="achat_personnel"/>
                                <field name="pv_strategie"/>
                            </group>
                            <group string="Montants" colspan="1">
                                <field name="prix_ttc" widget="monetary"/>
                                <field name="base_commissionnement" widget="monetary"/>
                            </group>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vue Recherche Investissement Immobilier -->
    <record id="view_investissement_immobilier_search" model="ir.ui.view">
        <field name="name">gaoh.investissement_immobilier.search</field>
        <field name="model">gaoh.investissement_immobilier</field>
        <field name="arch" type="xml">
            <search string="Rechercher Investissement Immobilier">
                <field name="nom_programme"/>
                <field name="ville_programme"/>
                <field name="investisseur_id"/>
                <field name="promoteur"/>
                <field name="consultant_apporteur"/>
                <filter string="Pinel" name="pinel" domain="[('dispositif_fiscal', '=', 'pinel')]"/>
                <filter string="LMNP" name="lmnp" domain="[('dispositif_fiscal', '=', 'lmnp')]"/>
                <filter string="En Cours" name="en_cours" domain="[('etat_commande', '=', 'en_cours')]"/>
                <filter string="Signée" name="signee" domain="[('etat_commande', '=', 'signee')]"/>
                <filter string="Livrée" name="livree" domain="[('etat_commande', '=', 'livree')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Investisseur" name="group_investisseur" context="{'group_by': 'investisseur_id'}"/>
                    <filter string="Ville" name="group_ville" context="{'group_by': 'ville_programme'}"/>
                    <filter string="Promoteur" name="group_promoteur" context="{'group_by': 'promoteur'}"/>
                    <filter string="Dispositif Fiscal" name="group_dispositif" context="{'group_by': 'dispositif_fiscal'}"/>
                    <filter string="État" name="group_etat" context="{'group_by': 'etat_commande'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Investissement Immobilier -->
    <record id="action_investissement_immobilier" model="ir.actions.act_window">
        <field name="name">Investissements Immobiliers</field>
        <field name="res_model">gaoh.investissement_immobilier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouvel investissement immobilier
            </p>
            <p>
                Suivez les investissements immobiliers de vos clients.
            </p>
        </field>
    </record>
</odoo>
