<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégorie de groupes -->
        <record id="module_category_gaoh_conseil" model="ir.module.category">
            <field name="name">Gaoh Conseil</field>
            <field name="description">Gestion des investisseurs et investissements</field>
            <field name="sequence">15</field>
        </record>

        <!-- Groupe Utilisateur -->
        <record id="group_gaoh_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_gaoh_conseil"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Manager -->
        <record id="group_gaoh_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_gaoh_conseil"/>
            <field name="implied_ids" eval="[(4, ref('group_gaoh_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
